{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Blocos",
  "version": "0.1.0",
  "identifier": "br.blocos.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blocos",
        "width": 1240,
        "height": 800,
        "minWidth": 780,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Editor de notas em Markdown",
    "longDescription": "Blocos é um editor de notas moderno para arquivos .md e .txt, com abas, formatação, destaques e sessão restaurada.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Documento Markdown",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Texto",
        "description": "Texto simples",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "section": "editors",
        "desktopTemplate": "./blocos.desktop"
      }
    }
  }
}
